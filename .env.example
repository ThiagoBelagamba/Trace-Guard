# PostgreSQL
POSTGRES_PASSWORD=traceguard_dev

# RabbitMQ
RABBITMQ_PASSWORD=traceguard_dev

# Backend
DATABASE_URL=postgres://traceguard:traceguard_dev@localhost:5432/traceguard
RABBITMQ_URL=amqp://traceguard:traceguard_dev@localhost:5672
PORT=3001

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/v1/ws/events

# Backend CORS (opcional — default permite todas as origens em dev)
# CORS_ORIGIN=http://localhost:3000

# SDK / Demo App
TRACEGUARD_ENDPOINT=http://localhost:3001/api/v1/ingest
TRACEGUARD_SERVICE_NAME=demo-app

# Redis (Fase 5 — EventHub pub/sub + RASP distribuído)
REDIS_URL=redis://localhost:6379

# Webhook de alertas (Slack/Discord — opcional)
ALERT_WEBHOOK_URL=

# Deploy produção (docker-compose.prod.yml)
# PUBLIC_API_URL=http://seu-host:3001
# PUBLIC_WS_URL=ws://seu-host:3001/api/v1/ws/events
# CORS_ORIGIN=http://seu-host:3000
